<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" color="#333333" line-height="24px"></mj-text>
      <mj-section padding="0px"></mj-section>
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Top Accent Bar -->
    <mj-section background-color="#5e2b3b" padding="5px 0">
    </mj-section>
    
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column width="100%">
        <!-- Logo Section -->
        <mj-image src="{{ server_host }}/assets/images/botho-logo.png" alt="Botho Logo" width="120px" padding-bottom="30px"></mj-image>
        
        <mj-divider border-color="#f4f4f4" border-width="1px" padding-bottom="30px"></mj-divider>
        
        <!-- Content Section -->
        <mj-text align="center" font-size="20px" font-weight="bold" color="#333333" padding-bottom="20px">Item Return Reminder</mj-text>
        <mj-text align="center" padding-bottom="10px">Hi {{ recipient_name }},</mj-text>
        <mj-text align="center" padding-bottom="20px">
          This is a friendly reminder from <strong>{{ lender_name }}</strong> to return the item <strong>'{{ item_title }}'</strong>.
        </mj-text>
        
        <mj-text align="center" font-weight="bold" color="#fb6635" padding-bottom="30px">
          Due Date: {{ due_date }}
        </mj-text>
        
        <mj-text align="center" padding-bottom="30px">
          Please return it as soon as possible to maintain your honor score and keep the community thriving.
        </mj-text>
        
        <!-- Action Button -->
        <mj-button align="center" font-size="16px" font-weight="bold" background-color="#fb6635" border-radius="4px" color="#ffffff" href="{{ link }}" padding="20px 30px">
          VIEW MY LOANS
        </mj-button>
        
      </mj-column>
    </mj-section>
    
    <!-- Footer Section -->
    <mj-section padding="30px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-size="12px" color="#999999">
          &copy; 2026 Botho. All rights reserved.<br/>
          This is an automated message, please do not reply.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>