<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" color="#333333" line-height="24px"></mj-text>
      <mj-section padding="0px"></mj-section>
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Top Accent Bar -->
    <mj-section background-color="#2b5e4e" padding="5px 0">
    </mj-section>
    
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column width="100%">
        <!-- Logo Section -->
        <mj-image src="{{ server_host }}/assets/images/botho-logo.png" alt="Botho Logo" width="120px" padding-bottom="30px"></mj-image>
        
        <mj-divider border-color="#f4f4f4" border-width="1px" padding-bottom="30px"></mj-divider>
        
        <!-- Content Section -->
        <mj-text align="center" font-size="20px" font-weight="bold" color="#333333" padding-bottom="20px">New Donation Request</mj-text>
        <mj-text align="center" padding-bottom="10px">Hi!</mj-text>
        <mj-text align="center" padding-bottom="20px">
          <strong>{{ donor_name }}</strong> has requested to donate <strong>'{{ item_title }}'</strong> to the community <strong>{{ community_name }}</strong>.
        </mj-text>
        
        <mj-text align="center" padding-bottom="30px">
          Please review the donation request in the community items tab.
        </mj-text>
        
        <!-- Action Button -->
        <mj-button align="center" font-size="16px" font-weight="bold" background-color="#2b5e4e" border-radius="4px" color="#ffffff" href="{{ link }}" padding="20px 30px">
          REVIEW DONATION
        </mj-button>
        
      </mj-column>
    </mj-section>
    
    <!-- Footer Section -->
    <mj-section padding="30px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-size="12px" color="#999999">
          &copy; 2026 {{ project_name }}. All rights reserved.<br/>
          This is an automated message, please do not reply.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>