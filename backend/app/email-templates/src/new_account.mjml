<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" color="#333333" line-height="24px"></mj-text>
      <mj-section padding="0px"></mj-section>
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Top Accent Bar -->
    <mj-section background-color="#5e2b3b" padding="5px 0">
    </mj-section>
    
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column width="100%">
        <!-- Logo Section -->
        <mj-image src="{{ server_host }}/assets/images/botho-logo.png" alt="Botho Logo" width="120px" padding-bottom="30px"></mj-image>
        
        <mj-divider border-color="#f4f4f4" border-width="1px" padding-bottom="30px"></mj-divider>
        
        <!-- Content Section -->
        <mj-text align="center" font-size="20px" font-weight="bold" color="#333333" padding-bottom="20px">Welcome to Botho!</mj-text>
        <mj-text align="center" padding-bottom="10px">Your new account has been created successfully.</mj-text>
        <mj-text align="center" padding-bottom="20px">Here are your temporary login details:</mj-text>
        
        <mj-section background-color="#f9f9f9" padding="10px">
          <mj-column width="100%">
            <mj-text align="center" font-family="monospace"><strong>Username:</strong> {{ username }}</mj-text>
            <mj-text align="center" font-family="monospace"><strong>Password:</strong> {{ password }}</mj-text>
          </mj-column>
        </mj-section>
        
        <mj-text align="center" padding-top="30px" padding-bottom="30px">We recommend changing your password after your first login.</mj-text>
        
        <!-- Action Button -->
        <mj-button align="center" font-size="16px" font-weight="bold" background-color="#2b5e4e" border-radius="4px" color="#ffffff" href="{{ link }}" padding="20px 30px">
          GO TO DASHBOARD
        </mj-button>
      </mj-column>
    </mj-section>
    
    <!-- Footer Section -->
    <mj-section padding="30px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-size="12px" color="#999999">
          &copy; 2026 Botho. All rights reserved.<br/>
          This is an automated message, please do not reply.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>