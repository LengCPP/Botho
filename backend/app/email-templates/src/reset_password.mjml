<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" color="#333333" line-height="24px"></mj-text>
      <mj-section padding="0px"></mj-section>
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Top Accent Bar -->
    <mj-section background-color="#5e2b3b" padding="5px 0">
    </mj-section>
    
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column width="100%">
        <!-- Logo Section -->
        <mj-image src="https://demo.botho.app/assets/images/botho-logo.png" alt="Botho Logo" width="120px" padding-bottom="30px"></mj-image>
        
        <mj-divider border-color="#f4f4f4" border-width="1px" padding-bottom="30px"></mj-divider>
        
        <!-- Content Section -->
        <mj-text align="center" font-size="20px" font-weight="bold" color="#333333" padding-bottom="20px">Password Recovery</mj-text>
        <mj-text align="center" padding-bottom="10px">Hello {{ username }},</mj-text>
        <mj-text align="center" padding-bottom="30px">We received a request to reset your password. Click the button below to choose a new one.</mj-text>
        
        <!-- Action Button -->
        <mj-button align="center" font-size="16px" font-weight="bold" background-color="#2b5e4e" border-radius="4px" color="#ffffff" href="{{ link }}" padding="20px 30px">
          RESET PASSWORD
        </mj-button>
        
        <mj-text align="center" font-size="14px" color="#777777" padding-top="30px">
          This link will expire in {{ valid_hours }} hours.
        </mj-text>
        <mj-text align="center" font-size="14px" color="#777777">
          If you didn't request a password reset, you can safely ignore this email.
        </mj-text>
        
        <mj-text align="center" font-size="12px" color="#5e2b3b" padding-top="20px">
          <a href="{{ link }}" style="color: #5e2b3b; text-decoration: none;">{{ link }}</a>
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Footer Section -->
    <mj-section padding="30px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-size="12px" color="#999999">
          &copy; 2026 Botho. All rights reserved.<br/>
          This is an automated message, please do not reply.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>